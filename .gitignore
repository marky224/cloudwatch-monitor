# Terraform state — contains secrets, never commit
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Backend config — holds the state bucket name (contains the account ID)
*.tfbackend
!*.tfbackend.example

# Saved plans (contain the full state) and local override files
*.tfplan
tfplan
*_override.tf

# Variable overrides with sensitive values
terraform.tfvars

# Generated canary zip (built by Terraform's archive_file)
canary-script/canary*.zip

# Generated Lambda zip (built by Terraform's archive_file)
status-page/generate-status.zip

# OS files
.DS_Store
